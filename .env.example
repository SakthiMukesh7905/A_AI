# SignAlert Configuration File

# Twilio Free Trial Credentials (Fill with your Twilio Console values)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# Multi-Tier Caregiver Contacts (Must be verified in Twilio Console for Free Trial)
CAREGIVER_PHONE_NUMBER=+91XXXXXXXXXX
SECONDARY_CAREGIVER_PHONE_NUMBER=+91XXXXXXXXXX

# Ring Timeout before Escalating from Primary to Secondary (in seconds)
CALL_TIMEOUT_SECONDS=15

# Emergency Trigger Rules
CONFIDENCE_THRESHOLD=0.70
COOLDOWN_SECONDS=30

# Options
ENABLE_VOICE_CALL=true
